// ADMINISTRATIVE DEPARTMENT SUITS
// [SCP]

/obj/item/clothing/suit/storage/scp/admin/sid_jacket
	name = "site director's jacket"
	desc = "A black suit jacket tailored from the most luxurious fabric, usually worn by the Site Director of a site. It has a golden nameplate on the chest."
	icon_state = "sid_jacket"

/obj/item/clothing/suit/storage/scp/admin/hro_jacket
	name = "human resources officer's jacket"
	desc = "A dark grey suit jacket tailored from the most luxurious fabric, usually worn by the Human Resources Officer of a site. It has a white nameplate on the chest."
	icon_state = "hro_jacket"

/obj/item/clothing/suit/storage/scp/admin/ec_jacket
	name = "ethics committee official's jacket"
	desc = "A black suit jacket tailored from the most luxurious fabric, usually worn by officials of the Ethics Committee. It has a golden nameplate on the chest, and green patches on the shoulder."
	icon_state = "ec_jacket"

/obj/item/clothing/suit/storage/scp/admin/ecl_jacket
	name = "ethics committee liaison's jacket"
	desc = "A dark grey suit jacket tailored from the most luxurious fabric, usually worn by Liaisons of the Ethics Committee. It has a silver nameplate on the chest, and green patches on the shoulder."
	icon_state = "ecl_jacket"

/obj/item/clothing/suit/storage/scp/admin/itd_coat
	name = "internal tribunal official's coat"
	desc = "A heavy, black long coat with golden markings along the wrists, as well as real genuine polar bear fur on it. It's woven from the finest cotton."
	icon_state = "itd_coat"
	body_parts_covered = UPPER_TORSO|LOWER_TORSO|LEGS|ARMS

/obj/item/clothing/suit/storage/scp/admin/itdo_coat
