// GLOBAL OCCULT COALITION UNIFORMS
// [SCP]

/obj/item/clothing/under/rank/scp/goc/rep
	name = "Global Occult Coalition representative's suit"
	desc = "A white formal shirt, with a cyan suit trousers buckled on with a golden belt buckle. It has insignia of a executive officer of the Global Occult Coalition. You have a feeling whoever wears this doesn't care for SoP."
	icon_state = "goc_rep"
	worn_state = "goc_rep"

/obj/item/clothing/under/rank/scp/goc/psyche
	name = "Global Occult Coalition PSYCHE division suit"
	desc = "A white formal shirt, with a black suit trousers buckled on with a silver belt buckle. It has insignia of the Global Occult Coalition's diplomatic arm."
	icon_state = "goc_staff"
	worn_state = "goc_staff"

/obj/item/clothing/under/rank/scp/goc/ptolemy
	name = "Global Occult Coalition PTOLEMY division suit"
	desc = "A blue-ish white formal shirt, with a black suit trousers buckled on with a silver belt buckle. It has insignia of the Global Occult Coalition's research arm."
	icon_state = "goc_research"
	worn_state = "goc_research"

/obj/item/clothing/under/rank/scp/goc/combat
	name = "Global Occult Coalition PHYSICS combat uniform"
	desc = "Some combat-wear worn by the GOC's PHYSICS division, it's a dark blue field combat suit, with a black torso. It involves a silver tactical belt, and a Global Occult Coalition patch on one of the shoulders."
	icon_state = "goc_combat"
	worn_state = "goc_combat"

/obj/item/clothing/under/rank/scp/goc/admin
	name = "Global Occult Coalition command's suit"
	desc = "A white formal shirt dawned with golden insignia, with a black suit trousers with golden stripes buckled on with a golden belt buckle. It has insignia of the Global Occult Coalition, whoever is wearing this must be important."
	icon_state = "goc_admin"
	worn_state = "goc_admin"

